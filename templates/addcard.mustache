{{!
    @template mod_kanbanlearning/addcard

    Template for the whole kanbanlearning board.

    Example context (json):
    {
        "id": 7,
        "kanbanlearning_column": 4,
        "addcard": true
    }
}}
<div class="mod_kanbanlearning_addcard_container row" data-id="{{^kanbanlearning_column}}0{{/kanbanlearning_column}}{{#kanbanlearning_column}}{{id}}{{/kanbanlearning_column}}">
    <button class="mod_kanbanlearning_addcard btn btn-icon icon-no-margin p-0{{^addcard}} hidden{{/addcard}}" id="mod_kanbanlearning_addcard_{{id}}" data-action="add_card" data-columnid="{{#kanbanlearning_column}}{{kanbanlearning_column}}{{/kanbanlearning_column}}{{^kanbanlearning_column}}{{id}}{{/kanbanlearning_column}}" data-id="{{id}}">{{#pix}} t/add, core, {{#str}} addcard, mod_kanbanlearning {{/str}} {{/pix}}</button>
</div>